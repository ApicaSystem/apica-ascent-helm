# =============================================================================
# Apica Ascent installer secrets — copy to ascent-secrets.conf, chmod 600.
# Loaded automatically when it sits next to ascent.conf (or set SECRETS_FILE).
# Plain KEY=value, never sourced. A value containing ' must use "…" and vice versa.
# Alternative: export ASCENT_ADMIN_PASSWORD, ASCENT_PG_PASSWORD, ASCENT_S3_ACCESS,
# ASCENT_S3_SECRET in the environment instead (CI / secret managers).
# =============================================================================
ADMIN_PASSWORD='change-me'             # >= 12 chars with upper, lower, digit AND special char
PG_PASSWORD='change-me-too'            # >= 8 chars, ONLY [A-Za-z0-9 . _ ~ -] (goes into DB URLs)
S3_ACCESS=''
S3_SECRET=''
